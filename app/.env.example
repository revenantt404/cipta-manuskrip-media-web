# Koneksi database MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cipta_manuskrip_media

# Katalog: jumlah buku per halaman (brief bagian 9 menetapkan 12)
BOOKS_PER_PAGE=12

# Ukuran maksimum file sampul dalam byte (brief bagian 6 menetapkan 5 MiB).
COVER_MAX_BYTES=5242880

# Alamat dasar situs, tanpa garis miring di ujung. Domain produksi belum
# dibeli, jadi nilai ini berisi localhost dan WAJIB diganti dengan domain
# asli saat deploy — metadataBase, robots.txt, dan sitemap.xml memakainya.
# Bila dikosongkan, aplikasi jatuh ke http://localhost:3000.
SITE_URL=http://localhost:3000

# Folder fisik penyimpanan sampul. Bila dikosongkan, dipakai storage/covers
# di dalam folder aplikasi. Di hosting, arahkan ke folder DI LUAR folder
# aplikasi supaya sampul tidak hilang saat deploy ulang.
#
# Folder ini tidak disajikan sebagai berkas statis: isinya dibaca oleh route
# /covers/[berkas] per permintaan, karena Next.js membekukan daftar berkas
# public/ saat server menyala.
COVER_DIR=
